Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"J", ">", "0"}], " ", "&&", " ", 
    RowBox[{"\[Epsilon]", " ", ">", "0"}], "&&", " ", 
    RowBox[{"\[Alpha]", ">", "0"}], "&&", 
    RowBox[{"\[Omega]", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "J", ",", "\[Epsilon]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"J", ",", "0", ",", "\[Epsilon]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", "\[Epsilon]", ",", "0"}], "}"}]}], "}"}]}], 
   ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "system", " ", "hamiltonian", " ", "in", " ", "local", " ", "site", " ", 
    "basis"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Slist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "01"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dens", "[", "x_", "]"}], ":=", 
    RowBox[{"2", "*", "\[Alpha]", "*", "x", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "x"}], "/", "\[Omega]"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "spectral", " ", "density", " ", "function", " ", "for", " ", "baths"}], 
     "-", 
     RowBox[{"assume", " ", "all", " ", "have", " ", "same", " ", "alpha"}]}],
     ",", "wc"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eta", "[", 
     RowBox[{"beta", ",", "x_"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"\[Beta]", "*", "x"}], "]"}], "-", "1"}], ")"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"the", " ", "thermal", " ", "factor"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gammafunc", "[", "w_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"w", ">", "0"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "/", "4"}], ")"}], "*", 
      RowBox[{"dens", "[", 
       RowBox[{"Abs", "[", "w", "]"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"eta", "[", 
         RowBox[{"Abs", "[", "w", "]"}], "]"}], "+", "1"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "/", "4"}], ")"}], "*", 
      RowBox[{"dens", "[", 
       RowBox[{"Abs", "[", "w", "]"}], "]"}], "*", 
      RowBox[{"eta", "[", 
       RowBox[{"Abs", "[", "w", "]"}], "]"}]}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evals", ",", "evecs"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "H", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"deltaE", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"deltaE", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"evals", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "-", 
       RowBox[{"evals", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"matrix", " ", "with", " ", "energy", " ", "differnces"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Seig", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Seig", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "evecs", "]"}], ".", 
       RowBox[{"Slist", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ".", "evecs"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "put", " ", "coupling", " ", "operators", " ", "into", " ", "energy", " ", 
    "basis"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "^", "2"}], ",", 
        RowBox[{"n", "^", "2"}], ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"empty", " ", "redfield", " ", "tensor"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"idx", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
